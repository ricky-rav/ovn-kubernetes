{% if in_upgrade != "true" -%}
---
# ovn-namespace.yaml
#
# Setup for Kubernetes to support the ovn-kubernetes plugin
#
# Create the namespace for ovn-kubernetes.
#
# This provisioning is done as part of installation after the cluster is
# up and before the ovn daemonsets are created.

apiVersion: v1
kind: Namespace
metadata:
  name: ovn-kubernetes

---
# Setup for Kubernetes to support the ovn-kubernetes plugin
#
# Create service accounts and policies.
# ovnkube interacts with kubernetes and the environment
# must be properly set up.
# 
# This provisioning is done as part of installation after the cluster is
# up and before the ovn daemonsets are created.

{%- endif %}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ovn-master
  namespace: ovn-kubernetes

---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ovn-node
  namespace: ovn-kubernetes

---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ovn-node-dpu-host
  namespace: ovn-kubernetes

---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ovn-db
  namespace: ovn-kubernetes

---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ovn-misc
  namespace: ovn-kubernetes

---
# RBAC policies for ovnk8s-master
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: ovn-master
rules:
- apiGroups:
  - ""
  resources:
  - pods
  - nodes
  verbs: ["get", "list", "watch", "patch", "update"]
- apiGroups:
  - ""
  resources:
  - namespaces
  - services
  verbs: ["get", "list", "watch"]
- apiGroups:
  - extensions
  - networking.k8s.io
  - apps
  resources:
  - networkpolicies
  verbs: ["get", "list", "watch"]
- apiGroups:
  - discovery.k8s.io
  resources:
  - endpointslices
  verbs: ["get", "list", "watch"]
- apiGroups:
  - k8s.ovn.org
  resources:
  - egressfirewalls
  - egressips
  - adminpolicybasedroutes
  - adminpolicybasedroutes/status
  - virtualips
  - virtualips/status
  - ipreservations
  - ipreservations/status
  - portmirrors
  - portmirrors/status
  verbs: ["get", "list", "watch", "update", "patch"]
- apiGroups:
  - k8s.cni.cncf.io
  resources:
  - network-attachment-definitions
  - multi-networkpolicies
  verbs: ["get", "list", "watch"]
- apiGroups: [""]
  resources: ["events"]
  verbs: ["create", "patch", "update"]
- apiGroups: [""]
  resources:
  - nodes/status
  - pods/status
  - services/status
  verbs: [ "patch", "update" ]

---
# RBAC policies for ovnk8s-node and ovnk8s-node-dpu
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: ovn-node
rules:
- apiGroups:
  - ""
  resources:
  - pods
  verbs: ["get", "list", "watch", "update"]
- apiGroups:
  - ""
  resources:
  - nodes
  verbs: ["get", "list", "watch", "patch"]
- apiGroups:
  - ""
  resources:
  - services
  - namespaces
  verbs: ["get", "list", "watch"]
- apiGroups:
  - discovery.k8s.io
  resources:
  - endpointslices
  verbs: ["get", "list", "watch"]
- apiGroups:
  - k8s.cni.cncf.io
  resources:
  - network-attachment-definitions
  verbs: ["get", "list", "watch"]
- apiGroups: [""]
  resources: ["events"]
  verbs: ["create", "patch", "update"]
- apiGroups:
  - k8s.ovn.org
  resources:
  - egressips
  verbs: ["get", "list", "watch"]
- apiGroups: [""]
  resources:
      - nodes/status
      - pods/status
  verbs: [ "patch", "update" ]
- apiGroups:
  - k8s.ovn.org
  resources:
  - portmirrors
  - portmirrors/status
  verbs: ["get", "list", "watch", "update"]

---
# RBAC policies for ovnk8s-node-dpu-host
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: ovn-node-dpu-host
rules:
- apiGroups:
  - ""
  resources:
  - nodes
  verbs: ["get", "list", "watch"]
- apiGroups:
  - ""
  resources:
  - pods
  verbs: ["get", "list", "watch", "update"]
- apiGroups:
  - ""
  resources:
  - services
  - namespaces
  verbs: ["get", "list", "watch"]
- apiGroups:
  - discovery.k8s.io
  resources:
  - endpointslices
  verbs: ["get", "list", "watch"]
- apiGroups: [""]
  resources: ["events"]
  verbs: ["create", "patch", "update"]
- apiGroups:
  - k8s.ovn.org
  resources:
  - egressips
  verbs: ["get", "list", "watch"]
- apiGroups: [""]
  resources:
      - nodes/status
      - pods/status
  verbs: [ "patch", "update" ]
- apiGroups:
  - k8s.cni.cncf.io
  resources:
  - network-attachment-definitions
  verbs: ["get", "list", "watch"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ovn-master
roleRef:
  name: ovn-master
  kind: ClusterRole
  apiGroup: rbac.authorization.k8s.io
subjects:
- kind: ServiceAccount
  name: ovn-master
  namespace: ovn-kubernetes

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ovn-node
roleRef:
  name: ovn-node
  kind: ClusterRole
  apiGroup: rbac.authorization.k8s.io
subjects:
- kind: ServiceAccount
  name: ovn-node
  namespace: ovn-kubernetes

---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ovn-node-dpu-host
roleRef:
  name: ovn-node-dpu-host
  kind: ClusterRole
  apiGroup: rbac.authorization.k8s.io
subjects:
- kind: ServiceAccount
  name: ovn-node-dpu-host
  namespace: ovn-kubernetes

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: ovn-kubernetes
  name: ovn-k8s-configmaps
rules:
- apiGroups: [""]
  resources: ["configmaps"]
  verbs: ["get", "watch", "list"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: ovn-kubernetes
  name: ovn-k8s-endpoints
rules:
- apiGroups:
  - ""
  resources:
  - endpoints
  verbs: ["get"]

---
# RBAC policies for ovnkube-db, ovn-nbdb-raft and ovn-sbdb-raft
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: ovn-kubernetes
  name: ovn-db
rules:
- apiGroups:
  - ""
  resources:
  - pods
  verbs: ["get", "list"]
- apiGroups: [""]
  resources:
  - endpoints
  verbs: ["get", "create"]
- apiGroups:
  - extensions
  - networking.k8s.io
  - apps
  resources:
  - statefulsets
  verbs: ["get"]

---

apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: only-ovnk8s-configmaps
  namespace: ovn-kubernetes
roleRef:
  name: ovn-k8s-configmaps
  kind: Role
  apiGroup: rbac.authorization.k8s.io
subjects:
- kind: ServiceAccount
  name: ovn
  namespace: ovn-kubernetes
- kind: ServiceAccount
  name: ovn-master
  namespace: ovn-kubernetes
- kind: ServiceAccount
  name: ovn-node
  namespace: ovn-kubernetes
- kind: ServiceAccount
  name: ovn-node-dpu-host
  namespace: ovn-kubernetes
- kind: ServiceAccount
  name: ovn-db
  namespace: ovn-kubernetes
- kind: ServiceAccount
  name: ovn-misc
  namespace: ovn-kubernetes

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: only-ovnk8s-endpoints
  namespace: ovn-kubernetes
roleRef:
  name: ovn-k8s-endpoints
  kind: Role
  apiGroup: rbac.authorization.k8s.io
subjects:
- kind: ServiceAccount
  name: ovn
  namespace: ovn-kubernetes
- kind: ServiceAccount
  name: ovn-master
  namespace: ovn-kubernetes
- kind: ServiceAccount
  name: ovn-node
  namespace: ovn-kubernetes
- kind: ServiceAccount
  name: ovn-node-dpu-host
  namespace: ovn-kubernetes
- kind: ServiceAccount
  name: ovn-misc
  namespace: ovn-kubernetes

---
# RBAC role binding for ovnkube-db, ovn-sbdb-raft and ovn-nbdb-raft
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ovn-db
  namespace: ovn-kubernetes
roleRef:
  name: ovn-db
  kind: Role
  apiGroup: rbac.authorization.k8s.io
subjects:
- kind: ServiceAccount
  name: ovn-db
  namespace: ovn-kubernetes

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: ovn-kubernetes
  name: ovn-master-specific-roles
rules:
  - apiGroups:
      - coordination.k8s.io
    resources:
      - leases
    verbs: ["create", "get", "list", "update", "patch"]
  - apiGroups:
      - ""
    resources:
      - configmaps
    verbs: ["create", "patch", "update"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  namespace: ovn-kubernetes
  name: ovn-master-specific-rolebindings
roleRef:
  name: ovn-master-specific-roles
  kind: Role
  apiGroup: rbac.authorization.k8s.io
subjects:
  - kind: ServiceAccount
    namespace: ovn-kubernetes
    name: ovn-master

{% if in_upgrade != "true" -%}
---

# The network cidr and service cidr are set in the ovn-config configmap
kind: ConfigMap
apiVersion: v1
metadata:
  name: ovn-config
  namespace: ovn-kubernetes
data:
  net_cidr:      "{{ net_cidr }}"
  svc_cidr:      "{{ svc_cidr }}"
  k8s_apiserver: "{{ k8s_apiserver }}"
  mtu:           "{{ mtu_value | default('1440') }}"
  host_network_namespace: "{{ host_network_namespace }}"

---
# ovn-host-network-namespace.yaml
#
# Create the namespace for classifying host network traffic.
#
# This provisioning is done as part of installation after the cluster is
# up and before the ovn daemonsets are created.

apiVersion: v1
kind: Namespace
metadata:
  name: "{{ host_network_namespace }}"
{%- endif %}
