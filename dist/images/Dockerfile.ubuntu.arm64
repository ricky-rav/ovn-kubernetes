#
# The standard name for this image is ovn-kube-u

# Notes:
# This is for a development build where the ovn-kubernetes utilities
# are built in this Dockerfile and included in the image (instead of the deb package)
#
#
# So this file will change over time.

FROM ubuntu:20.04 as ovn

ARG K8S_VER="=1.21.1-00"
ARG OVS_VER
ARG OVN_VER
ARG JFROG_CREDENTIAL
USER root

RUN apt-get update && apt-get install -y arping firewalld iproute2 curl \
    iputils-ping util-linux gnupg apt-utils net-tools

# Get ovn from Nvidia controlled source, install OVS and OVN packages.
RUN echo "deb [trusted=yes] https://${JFROG_CREDENTIAL}@edge.urm.nvidia.com/artifactory/sw-ngn-sdn-debian focal main" | tee -a /etc/apt/sources.list.d/ngn-sdn-ovn.list && \
    curl -L edge.urm.nvidia.com/artifactory/api/gpg/key/public | apt-key add - && \
    echo "deb https://apt.kubernetes.io/ kubernetes-xenial main" | tee /etc/apt/sources.list.d/kubernetes.list && \
    curl -s https://packages.cloud.google.com/apt/doc/apt-key.gpg | apt-key add - && \
    apt-get update && \
    apt-get install -y openvswitch-switch$OVS_VER openvswitch-common$OVS_VER ovn-common$OVN_VER ovn-host$OVN_VER kubectl$K8S_VER && \
    mkdir -p /var/run/openvswitch && \
    apt-get -y autoremove curl gnupg apt-utils && \
    rm -f ngn-sdn-ovn.list

# ovnkube.sh is the entry point. This script examines environment
# variables to direct operation and configure ovn
COPY ovnkube.sh ovndb-raft-functions.sh git_info /root/

LABEL io.k8s.display-name="ovn kubernetes" \
      io.k8s.description="ovnkube ubuntu image" \
      maintainer="Girish Moodalbail <gmoodalbail@nvidia.com>"

WORKDIR /root
ENTRYPOINT /root/ovnkube.sh

FROM ovn as ovnkube

# Built in ../../go_controller, then the binaries are copied here.
# put things where they are in the pkg
RUN mkdir -p /usr/libexec/cni/
COPY ovnkube ovn-kube-util ovndbchecker /usr/bin/
COPY ovn-k8s-cni-overlay /usr/libexec/cni/ovn-k8s-cni-overlay

# override the pkg's ovn_k8s.conf with this local copy
COPY ovn_k8s.conf /etc/openvswitch/ovn_k8s.conf
