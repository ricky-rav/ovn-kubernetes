#
# The standard name for this image is ovn-kube-u

# Notes:
# This is for a development build where the ovn-kubernetes utilities
# are built in this Dockerfile and included in the image (instead of the deb package)
#
#
# So this file will change over time.

#TBD-merge ARG OSV=ubuntu:25.10
ARG OSV=ubuntu:20.04
FROM $OSV

ARG K8S_VER="=1.21.1-00"

# TODO: Below we have code that removes '=' prefix and '-1' suffix if specified:
# OVN_VER=${OVN_VER#=} &&\
# OVS_VER=${OVS_VER#=} &&\
# OVN_VER=${OVN_VER%-1} &&\
# OVS_VER=${OVS_VER%-1} &&\
# This code can be removed after CI/CD pipelines will be updated that adds this prefix
ARG OVS_VER  # Example: 3.3.1.5f875996.19422428
ARG OVN_VER  # Example: 24.03.2.e9db0dbb.21320785
ARG ARTIFACTORY_CERT
ARG DIST_CODE=focal

USER root

RUN apt-get update && apt-get install -y arping firewalld iproute2 curl \
    iputils-ping software-properties-common util-linux apt-transport-https net-tools nmap nftables

# Note: to update kubernetes version you need to update kubectl.sha256.arm64 files:
# $ export K8S_VER={new-version}
# $ curl -L https://dl.k8s.io/release/$K8S_VER/bin/linux/arm64/kubectl.sha256 > ./kubectl.sha256.arm64
# See SDN-3261 for more details.
COPY kubectl.sha256.arm64 /tmp/
RUN curl -L https://dl.k8s.io/release/v1.33.10/bin/linux/arm64/kubectl > /usr/bin/kubectl \
   && echo `cat /tmp/kubectl.sha256.arm64` /usr/bin/kubectl | sha256sum -c - \
   && chmod +x /usr/bin/kubectl

# Install OVS and OVN packages.
RUN \
OVN_VER=${OVN_VER#=} &&\
OVS_VER=${OVS_VER#=} &&\
OVN_VER=${OVN_VER%-1} &&\
OVS_VER=${OVS_VER%-1} &&\
echo "deb [trusted=yes] https://${ARTIFACTORY_CERT}@urm.nvidia.com/artifactory/sw-ngn-sdn-debian $DIST_CODE main" | tee -a /etc/apt/sources.list.d/ngn-sdn-ovn.list &&\
apt-get update && apt-get install -y openvswitch-switch=${OVS_VER}-1 openvswitch-common=${OVS_VER}-1 ovn-common=${OVN_VER}-1 ovn-host=${OVN_VER}-1 ovn-central=${OVN_VER}-1 &&\
rm -f /etc/apt/sources.list.d/ngn-sdn-ovn.list

RUN mkdir -p /var/run/openvswitch

# Built in ../../go_controller, then the binaries are copied here.
# put things where they are in the pkg
RUN mkdir -p /usr/libexec/cni/
COPY ovnkube ovn-kube-util ovndbchecker ovnkube-identity /usr/bin/
COPY ovn-k8s-cni-overlay /usr/libexec/cni/ovn-k8s-cni-overlay

# ovnkube.sh is the entry point. This script examines environment
# variables to direct operation and configure ovn
COPY ovnkube.sh /root/
COPY ovnkube-init.sh /root/
COPY ovndb-raft-functions.sh ovnkube-node-readiness-check.sh ovnkube-node-liveness-check.sh /root/
# override the pkg's ovn_k8s.conf with this local copy
COPY ovn_k8s.conf /etc/openvswitch/ovn_k8s.conf

# copy git commit number into image
COPY git_info /root

# iptables wrappers
#COPY ./iptables-scripts/iptables /usr/sbin/
#COPY ./iptables-scripts/iptables-save /usr/sbin/
#COPY ./iptables-scripts/iptables-restore /usr/sbin/
#COPY ./iptables-scripts/ip6tables /usr/sbin/
#COPY ./iptables-scripts/ip6tables-save /usr/sbin/
#COPY ./iptables-scripts/ip6tables-restore /usr/sbin/
LABEL io.k8s.display-name="ovn kubernetes" \
      io.k8s.description="ovnkube ubuntu image" \
      maintainer="Girish Moodalbail <gmoodalbail@nvidia.com>"

WORKDIR /root
ENTRYPOINT /root/ovnkube.sh
