ARG OSV=ubuntu:20.04
FROM $OSV

ARG K8S_VER="=1.21.1-00"
ARG OVS_VER
ARG OVN_VER
ARG ARTIFACTORY_CERT
ARG DIST_CODE=focal

USER root

RUN apt-get update && apt-get install -y arping firewalld iproute2 curl \
    iputils-ping software-properties-common util-linux apt-transport-https net-tools nmap

RUN curl -LO https://storage.googleapis.com/kubernetes-release/release/v1.27.11/bin/linux/arm64/kubectl && mv kubectl /usr/bin/kubectl && chmod +x /usr/bin/kubectl

# Install OVS and OVN packages.
RUN \
echo "deb [trusted=yes] https://${ARTIFACTORY_CERT}@urm.nvidia.com/artifactory/sw-ngn-sdn-debian $DIST_CODE main" | tee -a /etc/apt/sources.list.d/ngn-sdn-ovn.list &&\
apt-get update && apt-get install -y openvswitch-switch$OVS_VER openvswitch-common$OVS_VER ovn-common$OVN_VER ovn-host$OVN_VER &&\
rm -f /etc/apt/sources.list.d/ngn-sdn-ovn.list
